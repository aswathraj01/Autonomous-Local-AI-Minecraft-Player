# ============================================================
# Autonomous AI Minecraft Player — Configuration
# Copy this file to .env and fill in your values.
# ============================================================

# ─────────────────────────────────────────────
# Minecraft Server
# ─────────────────────────────────────────────
MC_HOST=localhost
MC_PORT=25565

# Minecraft Java Edition version string
# Supports new year-based versioning (26.2, 26.1, etc.) and classic (1.21.1, 1.20.4, etc.)
# Leave blank to let mineflayer auto-negotiate with the server
MC_VERSION=26.2

# Bot username (used in offline/cracked mode)
MC_USERNAME=AIPlayer

# Authentication mode: offline | microsoft
MC_AUTH=offline

# ─────────────────────────────────────────────
# LLM Provider
# ─────────────────────────────────────────────
LLM_PROVIDER=ollama

# Model name — recommended: qwen3:8b (best for RTX 3070 Ti)
# Other options: llama3.1:8b, deepseek-r1:8b, llama3.2:3b
LLM_MODEL=qwen3:8b

# Ollama server URL
OLLAMA_URL=http://localhost:11434

# Optional: cloud provider API key (not needed for local operation)
# OPENAI_API_KEY=

# ─────────────────────────────────────────────
# Agent Behaviour
# ─────────────────────────────────────────────

# How often the agent makes a high-level decision (milliseconds)
# Lower = more reactive but more LLM calls. Recommended: 10000–30000
DECISION_INTERVAL_MS=15000

# Vision: whether to send screenshots to a vision-capable model
# Requires a vision model (e.g., llava). Set false if your model is text-only.
VISION_ENABLED=false

# Debug mode: show agent reasoning in console
DEBUG_MODE=true

# ─────────────────────────────────────────────
# Personality Traits (0.0–1.0)
# ─────────────────────────────────────────────
PERSONALITY_CURIOSITY=0.7
PERSONALITY_CAUTION=0.6
PERSONALITY_RISK_TOLERANCE=0.4
PERSONALITY_EXPLORATION=0.7
PERSONALITY_BUILDING=0.5
PERSONALITY_COMBAT_AGGRESSION=0.4
PERSONALITY_RESOURCE_CONSERVATION=0.6

# ─────────────────────────────────────────────
# Memory & Storage
# ─────────────────────────────────────────────
# Directory for SQLite databases and world data
DATA_DIR=./data

# How often to auto-save memory (milliseconds)
MEMORY_SAVE_INTERVAL_MS=60000

# Max episodes to store (older ones pruned)
MAX_EPISODES=1000

# ─────────────────────────────────────────────
# Dashboard (Phase 8)
# ─────────────────────────────────────────────
DASHBOARD_ENABLED=false
DASHBOARD_PORT=3000

# ─────────────────────────────────────────────
# Reconnect Settings
# ─────────────────────────────────────────────
RECONNECT_ENABLED=true
RECONNECT_DELAY_MS=5000
RECONNECT_MAX_ATTEMPTS=20
