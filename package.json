{
  "name": "autonomous-local-ai-minecraft-player",
  "version": "1.0.0",
  "description": "Autonomous AI Minecraft player powered by a local LLM. Connects to a Minecraft server and independently survives, explores, and progresses toward defeating the Ender Dragon.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node src/index.ts",
    "dev:watch": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --forceExit",
    "lint": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "keywords": [
    "minecraft",
    "ai",
    "autonomous",
    "ollama",
    "mineflayer",
    "bot"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "minecraft-data": "^3.114.0",
    "mineflayer": "^4.38.0",
    "mineflayer-pathfinder": "^2.4.5",
    "ollama": "^0.6.3",
    "prismarine-viewer": "^1.33.0",
    "socket.io": "^4.8.3",
    "uuid": "^11.1.0",
    "vec3": "^0.1.10",
    "winston": "^3.19.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.3",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": {
            "module": "commonjs",
            "esModuleInterop": true
          }
        }
      ]
    },
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  },
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aswathraj01/Autonomous-Local-AI-Minecraft-Player.git"
  },
  "bugs": {
    "url": "https://github.com/aswathraj01/Autonomous-Local-AI-Minecraft-Player/issues"
  },
  "homepage": "https://github.com/aswathraj01/Autonomous-Local-AI-Minecraft-Player#readme"
}
